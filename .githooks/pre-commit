#!/bin/sh
# Auto-optimise newly-staged images to WebP before they enter a commit, so the
# large originals never land in git history. See scripts/optimize-images.mjs.
# Skips silently if sharp isn't installed yet (e.g. a fresh clone pre-install).
if ! node -e "require.resolve('sharp')" >/dev/null 2>&1; then
  exit 0
fi
node scripts/optimize-images.mjs --staged
