# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# secrets, keys & credentials
*.key
*.p12
*.pfx
*.crt
*.cert
*.keystore
*.jks
.npmrc
.netrc
.pgpass
*service-account*.json
*firebase-adminsdk*.json

# claude local settings (don't rely on the machine-global ignore)
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static

# claude code (local agent instructions — keep out of the repo)
CLAUDE.md
CLAUDE.local.md
